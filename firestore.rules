rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Trips Subcollection
      match /trips/{tripId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(tripId);
        allow delete: if isOwner(userId);
      }
    }

    // Captured Emails from "Email me my list"
    match /captured_emails/{emailId} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() >= 3;
      allow read, update, delete: if false;
    }

    // Referral code registry
    match /referral_codes/{code} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Referral attribution records
    match /referrals/{referralId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
